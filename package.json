{
  "name": "@objectstack/templates",
  "version": "0.1.0",
  "description": "Official starter templates for ObjectStack — consumed via `objectstack create --template <name>`",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/objectstack-ai/templates.git"
  },
  "scripts": {
    "dev": "pnpm --filter @objectlab/todo dev",
    "dev:all": "pnpm -r --filter=!@objectlab/all build && pnpm --filter @objectlab/all dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "publish:templates": "node scripts/publish-template.mjs",
    "publish:templates:dry-run": "DRY_RUN=1 node scripts/publish-template.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "msw"
    ]
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
