{
  "name": "HR — end-to-end business user workflow",
  "description": "Exercises the hr template's real schema (hr_employee, hr_time_off_request, hr_document): employee onboarding, the time-off request state machine (draft → submitted → approved), and document tracking. Targets the versioned data API (/api/v1/data/<object>).",
  "scenarios": [
    {
      "id": "S1-employee-onboarding",
      "name": "HR onboards a new employee",
      "description": "Create an active full-time employee and verify the core identity fields persist.",
      "tags": ["smoke", "employee"],
      "steps": [
        {
          "name": "create_employee",
          "action": {
            "type": "create_record",
            "target": "hr_employee",
            "payload": {
              "full_name": "Dana Okoye",
              "work_email": "dana.okoye+{{runId}}@acme.test",
              "status": "active",
              "employment_type": "full_time",
              "job_title": "Product Designer"
            }
          },
          "capture": {
            "employeeId": "id"
          },
          "assertions": [
            {
              "field": "record.full_name",
              "operator": "equals",
              "expectedValue": "Dana Okoye"
            },
            {
              "field": "record.status",
              "operator": "equals",
              "expectedValue": "active"
            },
            {
              "field": "record.id",
              "operator": "not_null",
              "expectedValue": null
            }
          ]
        }
      ]
    },
    {
      "id": "S2-time-off-lifecycle",
      "name": "An employee's time-off request moves through approval",
      "description": "Seed an employee, file a vacation request (draft), submit it, then approve it — verifying the status state machine.",
      "tags": ["time-off", "state-machine"],
      "setup": [
        {
          "name": "seed_employee",
          "action": {
            "type": "create_record",
            "target": "hr_employee",
            "payload": {
              "full_name": "Sam Rivera",
              "work_email": "sam.rivera+{{runId}}@acme.test",
              "status": "active",
              "employment_type": "full_time",
              "job_title": "Software Engineer"
            }
          },
          "capture": {
            "employeeId": "id"
          }
        }
      ],
      "steps": [
        {
          "name": "file_request",
          "action": {
            "type": "create_record",
            "target": "hr_time_off_request",
            "payload": {
              "employee": "{{employeeId}}",
              "leave_type": "vacation",
              "status": "draft",
              "start_date": "2026-07-01",
              "end_date": "2026-07-05"
            }
          },
          "capture": {
            "requestId": "id"
          },
          "assertions": [
            {
              "field": "record.status",
              "operator": "equals",
              "expectedValue": "draft"
            },
            {
              "field": "record.leave_type",
              "operator": "equals",
              "expectedValue": "vacation"
            }
          ]
        },
        {
          "name": "submit_request",
          "action": {
            "type": "update_record",
            "target": "hr_time_off_request",
            "payload": {
              "id": "{{requestId}}",
              "status": "submitted"
            }
          },
          "assertions": [
            {
              "field": "record.status",
              "operator": "equals",
              "expectedValue": "submitted"
            }
          ]
        },
        {
          "name": "approve_request",
          "action": {
            "type": "update_record",
            "target": "hr_time_off_request",
            "payload": {
              "id": "{{requestId}}",
              "status": "approved"
            }
          },
          "assertions": [
            {
              "field": "record.status",
              "operator": "equals",
              "expectedValue": "approved"
            }
          ]
        }
      ]
    },
    {
      "id": "S3-document-tracking",
      "name": "HR attaches a document to an employee",
      "description": "Seed an employee, store an employment-contract document, then read it back by id.",
      "tags": ["documents", "read"],
      "setup": [
        {
          "name": "seed_employee",
          "action": {
            "type": "create_record",
            "target": "hr_employee",
            "payload": {
              "full_name": "Priya Nair",
              "work_email": "priya.nair+{{runId}}@acme.test",
              "status": "active",
              "employment_type": "full_time",
              "job_title": "Software Engineer"
            }
          },
          "capture": {
            "employeeId": "id"
          }
        }
      ],
      "steps": [
        {
          "name": "create_document",
          "action": {
            "type": "create_record",
            "target": "hr_document",
            "payload": {
              "name": "Employment Contract",
              "employee": "{{employeeId}}",
              "doc_type": "contract",
              "issued_on": "2026-01-15"
            }
          },
          "capture": {
            "documentId": "id"
          },
          "assertions": [
            {
              "field": "record.name",
              "operator": "equals",
              "expectedValue": "Employment Contract"
            },
            {
              "field": "record.doc_type",
              "operator": "equals",
              "expectedValue": "contract"
            }
          ]
        },
        {
          "name": "read_back_document",
          "action": {
            "type": "read_record",
            "target": "hr_document",
            "payload": {
              "id": "{{documentId}}"
            }
          },
          "assertions": [
            {
              "field": "record.id",
              "operator": "equals",
              "expectedValue": "{{documentId}}"
            },
            {
              "field": "record.employee",
              "operator": "equals",
              "expectedValue": "{{employeeId}}"
            }
          ]
        }
      ]
    }
  ]
}
